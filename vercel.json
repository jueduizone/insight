{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel",
      "functions": {
        "Dockerfile.vercel": {
          "maxDuration": 300
        }
      }
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "crons": [
    {
      "path": "/api/cron/project-cleaner",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/github",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/activity-score",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/web3insight",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/profiles",
      "schedule": "30 */6 * * *"
    }
  ]
}
